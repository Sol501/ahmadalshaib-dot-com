/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/og-card-web-engineer.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon-32x32.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon-192x192.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/Ahmad-Alshaib-Web-Engineer-Resume.pdf
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Disposition: attachment; filename="Ahmad-Alshaib-Web-Engineer-Resume.pdf"
  X-Robots-Tag: noindex

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/robots.txt
